server {
    listen 80;
    server_name www.nickhome.cloud;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name www.nickhome.cloud;

    ssl_certificate /etc/letsencrypt/live/www.nickhome.cloud/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/www.nickhome.cloud/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 50m;

    # --- Pilot Code ---
    location /pilotAgent/api/ {
        rewrite ^/pilotAgent(.*)$ $1 break;
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /pilotAgent/api/events {
        rewrite ^/pilotAgent(.*)$ $1 break;
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 86400s;
        chunked_transfer_encoding off;
    }

    location /pilotAgent/ {
        rewrite ^/pilotAgent(.*)$ $1 break;
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # --- H5 Chat ---
    location /h5-chat/ {
        alias /var/www/chat/;
        try_files $uri $uri/ /h5-chat/index.html;
    }

    # H5 API proxy
    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_read_timeout 86400s;
    }

    # Redirect root to /pilotAgent/
    location = / {
        return 301 /pilotAgent/;
    }
}
